FROM docker.io/library/python:3.12-slim

# Match EP's immutable SDK source revision until these packages are on PyPI.
RUN pip install --no-cache-dir \
    'syntara-plugin-contracts @ https://github.com/syntara-orchestration/syntara-plugin-sdk/archive/28a5eb708123dd89cc3fcbc9f3e42ccfbc02db16.tar.gz#subdirectory=sdks/python/packages/contracts' \
    'syntara-plugin-runtime @ https://github.com/syntara-orchestration/syntara-plugin-sdk/archive/28a5eb708123dd89cc3fcbc9f3e42ccfbc02db16.tar.gz#subdirectory=sdks/python/packages/runtime'

COPY worker.py /opt/sdk-test-worker.py
USER 1001
EXPOSE 50051
CMD ["python", "/opt/sdk-test-worker.py"]
